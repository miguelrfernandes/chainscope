OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=1500

# "openai" (production default), "openrouter", or "0g" — see app/core/llm.py.
LLM_PROVIDER=openai

# 0G Compute Router API key (testnet) — get one at https://pc.testnet.0g.ai
# after depositing test tokens, and confirm ZG_MODEL against that dashboard's
# live model catalog.
ZG_API_KEY=
ZG_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_MODEL=llama-3.3-70b-instruct

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chainscope-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

GRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse
GRAPH_API_KEY=
PINAX_API_TOKEN=
PINAX_API_BASE_URL=https://api.pinax.network

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Public Hedera Mirror Node REST API, no key needed. Swap to
# https://mainnet.mirrornode.hedera.com for mainnet data.
HEDERA_MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com

# Hedera action agent (transfer_hbar, HCS topics, HTS tokens) — a dedicated
# backend-held TESTNET account, not the user's wallet. Get a free funded
# testnet account at https://portal.hedera.com/dashboard. Leave unset to
# disable the action agent; the read-only Hedera specialist above still works.
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_NETWORK=testnet
HEDERA_SCHEDULE_FACTORY_ADDRESS=
HEDERA_NATIVE_TRANSFER_STRATEGY_ADDRESS=

# Encrypts managed agents' Hedera private keys at rest (AES-256-GCM) — see
# app/tools/hedera_provisioner.py. Required; generate with `openssl rand -hex 32`.
AGENT_VAULT_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:3000
SANDBOX_TIMEOUT_SECONDS=10

# --- Deployment shape -------------------------------------------------
# Leave both unset for local dev and the VPS: stores use SQLite files and
# APScheduler runs in-process.
#
# On Vercel (no writable disk, no process between requests) both are
# required — see docs/setup.md:
#   DATABASE_URL   Postgres connection string. Without it the encrypted
#                  Hedera agent keys live on a disk that does not survive.
#   SCHEDULER_MODE "external" — skips the in-process scheduler; the
#                  GitHub Actions cron POSTs /api/scheduled-queries/tick.
#   CRON_SECRET    Shared secret for that endpoint. It refuses to run
#                  unless this is set and matches the caller's bearer
#                  token, since a tick triggers real agent runs.
DATABASE_URL=
SCHEDULER_MODE=embedded
CRON_SECRET=

UNISWAP_API_KEY=
UNISWAP_API_BASE_URL=https://trading-api-labs.interface.gateway.uniswap.org/v1
UNISWAP_DEFAULT_CHAIN_ID=1

